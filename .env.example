PORT=3000
HOST="0.0.0.0"

# Application URLs
NEXT_PUBLIC_APP_URL="https://chat.globalcrestsolutions.com"

# Database Configuration (MySQL 8+ / Hostinger Cloud Database)
DATABASE_URL="mysql://u797749929_user:password@127.0.0.1:3306/u797749929_dbname"

# Authentication & Session Security (Min 32 random bytes)
JWT_SECRET="gcs_connect_super_secure_jwt_secret_change_in_production_min32chars"
