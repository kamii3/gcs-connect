# ==============================================================================
# GCS CONNECT — ENVIRONMENT VARIABLES TEMPLATE
# "Connect Freely. Communicate Securely."
# ==============================================================================

# Server Environment
NODE_ENV="production"
PORT=3000
HOST="0.0.0.0"

# Application URLs
NEXT_PUBLIC_APP_URL="https://chat.globalcrestsolutions.com"

# Database Configuration (MySQL 8+ / Hostinger Cloud Database)
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:3306/YOUR_DB_NAME"

# Authentication & Session Security (Min 32 random bytes)
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
SESSION_COOKIE_NAME="gcs_session"
SESSION_EXPIRY_DAYS=7
COOKIE_SECURE="true"

# Initial System Administrator Seed
ADMIN_INITIAL_EMAIL="admin@globalcrestsolutions.com"
ADMIN_INITIAL_PASSWORD="ChangeMeOnFirstLogin2026!"
ADMIN_INITIAL_NAME="Global Crest Administrator"

# WebRTC STUN / TURN Configuration
STUN_SERVER_URL="stun:stun.l.google.com:19302"
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Encrypted Media Storage Vault
STORAGE_VAULT_PATH="./storage/vault"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
