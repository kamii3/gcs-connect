// ==============================================================================
// GCS CONNECT — Prisma ORM Schema Specification
// "Connect Freely. Communicate Securely."
// Production Database: MySQL 8+ / MariaDB 11
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. User & Account Management
// ------------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  displayName        String?   @map("display_name")
  avatarUrl          String?   @map("avatar_url")
  status             String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_ACTIVATION, DELETED
  isTwoFactorEnabled Boolean   @default(false) @map("is_two_factor_enabled")
  twoFactorSecret    String?   @map("two_factor_secret")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  roles              UserRole[]
  sessions           UserSession[]
  devices            Device[]
  memberships        ConversationMember[]
  initiatedCalls     Call[]               @relation("InitiatedCalls")
  callParticipations CallParticipant[]
  sentInvitations    Invitation[]         @relation("AdminInvitations")
  blocksInitiated    UserBlock[]          @relation("BlockerUsers")
  blockedBy          UserBlock[]          @relation("BlockedUsers")
  notifications      Notification[]
  auditLogs          AuditLog[]
  messageReactions   MessageReaction[]
  messageReceipts    MessageReceipt[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  role       String   @default("USER") // SUPER_ADMIN, ADMIN, SECURITY_AUDITOR, USER
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model Invitation {
  id          String    @id @default(uuid())
  email       String
  token       String    @unique
  role        String    @default("USER")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  invitedBy User @relation("AdminInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@map("invitations")
}

// ------------------------------------------------------------------------------
// 2. Devices & Stateful Sessions
// ------------------------------------------------------------------------------

model Device {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  deviceName        String   @map("device_name")
  deviceFingerprint String   @map("device_fingerprint")
  clientPlatform    String?  @map("client_platform")
  lastSeenAt        DateTime @default(now()) @map("last_seen_at")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         UserSession[]
  identityKey      EncryptionIdentityKey?
  signedPrekeys    SignedPrekey[]
  oneTimePrekeys   OneTimePrekey[]
  keyBundle        EncryptedKeyBundle?
  keyMetadata      DeviceKeyMetadata?
  messagesSent     Message[]                 @relation("SentMessages")
  messagesReceived Message[]                 @relation("ReceivedMessages")
  receipts         MessageReceipt[]
  participations   CallParticipant[]

  @@unique([userId, deviceFingerprint])
  @@index([userId, isActive])
  @@map("devices")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  deviceId         String    @map("device_id")
  sessionTokenHash String    @unique @map("session_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  isValid          Boolean   @default(true) @map("is_valid")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, isValid])
  @@index([deviceId])
  @@map("user_sessions")
}

// ------------------------------------------------------------------------------
// 3. End-to-End Encryption Key Architecture (Zero Plaintext)
// ------------------------------------------------------------------------------

model EncryptionIdentityKey {
  id                 String   @id @default(uuid())
  deviceId           String   @unique @map("device_id")
  publicIdentityKey  String   @db.Text @map("public_identity_key")
  keyAlgorithm       String   @default("Curve25519") @map("key_algorithm")
  createdAt          DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("encryption_identity_keys")
}

model SignedPrekey {
  id         String   @id @default(uuid())
  deviceId   String   @map("device_id")
  keyId      Int      @map("key_id")
  publicKey  String   @db.Text @map("public_key")
  signature  String   @db.Text @map("signature")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId, isActive])
  @@map("signed_prekeys")
}

model OneTimePrekey {
  id         String    @id @default(uuid())
  deviceId   String    @map("device_id")
  keyId      Int       @map("key_id")
  publicKey  String    @db.Text @map("public_key")
  isConsumed Boolean   @default(false) @map("is_consumed")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId, isConsumed])
  @@map("one_time_prekeys")
}

model EncryptedKeyBundle {
  id                  String   @id @default(uuid())
  deviceId            String   @unique @map("device_id")
  encryptedBackupBlob String   @db.LongText @map("encrypted_backup_blob")
  backupVersion       Int      @default(1) @map("backup_version")
  checksumSha256      String   @map("checksum_sha256")
  updatedAt           DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("encrypted_key_bundles")
}

model DeviceKeyMetadata {
  id                        String   @id @default(uuid())
  deviceId                  String   @unique @map("device_id")
  activeOneTimePrekeyCount  Int      @default(0) @map("active_opk_count")
  signedPrekeyRotationDueAt DateTime @map("spk_rotation_due_at")
  lastReplenishedAt         DateTime @default(now()) @map("last_replenished_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_key_metadata")
}

// ------------------------------------------------------------------------------
// 4. Conversations & Membership
// ------------------------------------------------------------------------------

model Conversation {
  id                          String    @id @default(uuid())
  type                        String    @default("DIRECT") // DIRECT, GROUP
  title                       String?
  avatarUrl                   String?   @map("avatar_url")
  createdByUserId             String?   @map("created_by_user_id")
  isEncrypted                 Boolean   @default(true) @map("is_encrypted")
  disappearingDurationSeconds Int?      @map("disappearing_duration_seconds")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  deletedAt                   DateTime? @map("deleted_at")

  members  ConversationMember[]
  messages Message[]
  calls    Call[]

  @@index([type])
  @@index([deletedAt])
  @@map("conversations")
}

model ConversationMember {
  id                   String    @id @default(uuid())
  conversationId       String    @map("conversation_id")
  userId               String    @map("user_id")
  role                 String    @default("MEMBER") // OWNER, ADMIN, MEMBER
  joinedAt             DateTime  @default(now()) @map("joined_at")
  leftAt               DateTime? @map("left_at")
  isMuted              Boolean   @default(false) @map("is_muted")
  isPinned             Boolean   @default(false) @map("is_pinned")
  isArchived           Boolean   @default(false) @map("is_archived")
  clearedHistoryBefore DateTime? @map("cleared_history_before")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
  @@index([conversationId])
  @@map("conversation_members")
}

// ------------------------------------------------------------------------------
// 5. Messages & Encrypted Media Attachments
// ------------------------------------------------------------------------------

model Message {
  id                    String    @id @default(uuid())
  conversationId        String    @map("conversation_id")
  senderDeviceId        String    @map("sender_device_id")
  recipientDeviceId     String?   @map("recipient_device_id")
  messageType           String    @default("TEXT") @map("message_type") // TEXT, IMAGE, VIDEO, AUDIO, DOCUMENT, STICKER, CALL_EVENT
  encryptedPayload      String    @db.LongText @map("encrypted_payload") // Base64 ciphertext
  initializationVector  String    @map("initialization_vector") // Base64 12-byte IV
  authTag               String    @map("auth_tag") // Base64 16-byte tag
  ephemeralKey          String?   @db.Text @map("ephemeral_key") // Ratchet public key
  ratchetSequenceNumber Int       @default(0) @map("ratchet_sequence_number")
  previousChainLength   Int       @default(0) @map("previous_chain_length")
  isDeletedForEveryone  Boolean   @default(false) @map("is_deleted_for_everyone")
  isEdited              Boolean   @default(false) @map("is_edited")
  editedAt              DateTime? @map("edited_at")
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderDevice    Device            @relation("SentMessages", fields: [senderDeviceId], references: [id], onDelete: Cascade)
  recipientDevice Device?           @relation("ReceivedMessages", fields: [recipientDeviceId], references: [id], onDelete: SetNull)
  attachments     Attachment[]
  receipts        MessageReceipt[]
  reactions       MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderDeviceId])
  @@index([recipientDeviceId])
  @@index([expiresAt])
  @@map("messages")
}

model Attachment {
  id                   String   @id @default(uuid())
  messageId            String   @map("message_id")
  storagePath          String   @unique @map("storage_path")
  encryptedMimeType    String   @map("encrypted_mime_type")
  fileSizeBytes        BigInt   @map("file_size_bytes")
  ciphertextSha256     String   @map("ciphertext_sha256")
  thumbnailStoragePath String?  @map("thumbnail_storage_path")
  createdAt            DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

model MessageReceipt {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  deviceId  String   @map("device_id")
  userId    String   @map("user_id")
  status    String   @default("DELIVERED") // SENT, DELIVERED, READ
  timestamp DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, deviceId, status])
  @@index([userId, status])
  @@map("message_receipts")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// ------------------------------------------------------------------------------
// 6. Stickers & Media Assets
// ------------------------------------------------------------------------------

model StickerPack {
  id           String   @id @default(uuid())
  name         String
  author       String
  thumbnailUrl String   @map("thumbnail_url")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")

  stickers Sticker[]

  @@map("sticker_packs")
}

model Sticker {
  id        String   @id @default(uuid())
  packId    String   @map("pack_id")
  imageUrl  String   @map("image_url")
  emoji     String?
  sortOrder Int      @default(0) @map("sort_order")

  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, sortOrder])
  @@map("stickers")
}

// ------------------------------------------------------------------------------
// 7. WebRTC Calling Engine
// ------------------------------------------------------------------------------

model Call {
  id              String    @id @default(uuid())
  conversationId  String    @map("conversation_id")
  initiatorUserId String    @map("initiator_user_id")
  callType        String    @default("VOICE") @map("call_type") // VOICE, VIDEO
  status          String    @default("INITIATED") // INITIATED, RINGING, CONNECTED, COMPLETED, REJECTED, MISSED, FAILED
  durationSeconds Int       @default(0) @map("duration_seconds")
  startedAt       DateTime  @default(now()) @map("started_at")
  connectedAt     DateTime? @map("connected_at")
  endedAt         DateTime? @map("ended_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator    User              @relation("InitiatedCalls", fields: [initiatorUserId], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([conversationId])
  @@index([initiatorUserId])
  @@index([status])
  @@map("calls")
}

model CallParticipant {
  id       String    @id @default(uuid())
  callId   String    @map("call_id")
  userId   String    @map("user_id")
  deviceId String    @map("device_id")
  status   String    @default("INVITED") // INVITED, ACCEPTED, DECLINED, LEFT, MISSED
  joinedAt DateTime? @map("joined_at")
  leftAt   DateTime? @map("left_at")

  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([callId, deviceId])
  @@index([userId])
  @@map("call_participants")
}

// ------------------------------------------------------------------------------
// 8. Privacy, Security & Notifications
// ------------------------------------------------------------------------------

model UserBlock {
  id            String   @id @default(uuid())
  blockerUserId String   @map("blocker_user_id")
  blockedUserId String   @map("blocked_user_id")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockerUsers", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUsers", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@map("user_blocks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // NEW_MESSAGE, INCOMING_CALL, SECURITY_ALERT, DEVICE_ADDED
  title     String
  body      String   // Generic notification, NO plaintext message exposure
  isRead    Boolean  @default(false) @map("is_read")
  metadata  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  actorEmail String   @map("actor_email")
  action     String   // USER_CREATED, SESSION_REVOKED, ACCOUNT_SUSPENDED, KEY_ROTATED
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String?  @db.Text
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorEmail])
  @@index([createdAt])
  @@map("audit_logs")
}
